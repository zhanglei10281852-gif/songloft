+	now := time.Now()
+	m.progress.Status = ScanStatusCancelled
+	m.progress.EndTime = &now
+	m.progress.CurrentFile = ""
+
+	if m.cancel != nil {
+		close(m.cancel)
+		m.cancel = nil
+	}
+}
