diff --git a/internal/jsplugin/uninstall.go b/internal/jsplugin/uninstall.go
new file mode 100644
index 0000000..4376494
--- /dev/null
+++ b/internal/jsplugin/uninstall.go
@@ -0,0 +1,174 @@
+package jsplugin
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"time"
+)
+
+// 删除运行态阶段的超时预算。
+const (
+	// pluginDrainTimeout 等待插件已排队/处理中的 HTTP 请求、设备事件等消息
+	// 排空的上限。插件最慢的合法调用可达 300s，但删除是管理员显式动作，过长的
+	// 在途调用宁可让本次删除失败可重试，也不能把 HTTP 请求挂死——超时后服务
+	// 恢复接客，调用方收到明确错误。
+	pluginDrainTimeout = 10 * time.Second
+	// pluginUnregisterTimeout 排空成功后等待调度 worker 退出的上限。
+	// 排空已确认队列归零，正常情况下立即完成。
+	pluginUnregisterTimeout = 5 * time.Second
+)
+
+// ErrPluginDeleting 插件删除流程正在进行：新的请求、懒加载、健康恢复、
+// 热更新与自动更新都不得再进入该插件。
+var ErrPluginDeleting = errors.New("jsplugin: plugin is being deleted")
+
+// IsPluginUninstallingError 判断错误是否为「删除中」或「删除未收敛」。
+func IsPluginUninstallingError(err error) bool {
+	return errors.Is(err, ErrPluginDeleting) || errors.Is(err, ErrPluginUninstalling)
+}
+
+// DeletePlugin 删除一个 JS 插件，两阶段执行：
+//
+//	阶段 1（运行态收敛，全部失败都中止且不动磁盘/DB）：
+//	  a. 标记 deleting —— 立即阻断新的 HTTP 请求、懒加载、健康恢复/唤醒、
+//	     热更新与自动更新；
+//	  b. DrainService 排空已排队与运行中的调用（超时则回滚放开、返回错误，
+//	     插件继续服务）；
+//	  c. 注销调度器、停止服务（定时器、onDeinit、后台进程、UDP/TCP/WebSocket、
+//	     脚本环境）；任一失败返回可观察错误，绝不进入破坏性阶段；
+//	  d. 撤销播放订阅、歌词/封面提供者、健康检查计划。
+//	阶段 2（持久收敛，见 PackageManager.Uninstall）：
+//	  先落盘删除墓碑，再删 ZIP → 数据目录（keep_data=true 保留）→ DB 记录 →
+//	  墓碑。部分失败或进程崩溃由下次启动的 RecoverPendingUninstalls 继续收敛。
+//
+// 成功后 publicPaths 立即刷新；同一 entryPath 可正常重新安装。
+// 返回被删插件元数据，供调用方清理宿主侧关联配置（tab/排序等）。
+func (m *Manager) DeletePlugin(ctx context.Context, pluginID int64, keepData bool) (*JSPlugin, error) {
+	plugin, err := m.repo.GetByID(ctx, pluginID)
+	if err != nil {
+		return nil, fmt.Errorf("get plugin by id %d: %w", pluginID, err)
+	}
+	entryPath := plugin.EntryPath
+
+	// a. 阻断新入口。LoadOrStore 保证同一 entryPath 同时只有一个删除流程。
+	if _, exists := m.deleting.LoadOrStore(entryPath, struct{}{}); exists {
+		return nil, fmt.Errorf("%w: %s", ErrPluginDeleting, entryPath)
+	}
+	// 无论阶段 2 成败都放开内存阻断：阶段 2 失败时记录仍在、墓碑保证删除意图
+	// 不丢（安装/更新/扫描被墓碑拦截），管理员可用同一 ID 重试 DELETE；
+	// 记录已删时插件本身已不存在，标记留着只会挡住同 entryPath 的重新安装。
+	defer m.deleting.Delete(entryPath)
+
+	// b+c. 排空 + 注销 + 停服。失败即中止，包与 DB 记录原样保留。
+	if err := m.quiesceForDelete(plugin); err != nil {
+		return nil, err
+	}
+
+	// d. 撤销宿主侧运行态注册。
+	m.playEventSubscribers.Delete(entryPath)
+	m.lyricProviders.Delete(entryPath)
+	m.coverProviders.Delete(entryPath)
+	if m.healthChecker != nil {
+		m.healthChecker.Forget(entryPath)
+	}
+	// 清掉自动更新里「已落盘但推迟重载」的待办，避免重试周期复活插件。
+	if m.autoUpdater != nil {
+		m.autoUpdater.ForgetPending(entryPath)
+	}
+
+	slog.Info("js plugin runtime quiesced for delete",
+		"entryPath", entryPath, "keepData", keepData)
+
+	// 阶段 2：墓碑 + ZIP/数据目录/DB 记录的幂等收敛。
+	if err := m.packager.Uninstall(pluginID, keepData); err != nil {
+		return nil, fmt.Errorf("uninstall plugin %q: %w", entryPath, err)
+	}
+
+	// DB 记录已删除，重建 publicPaths 缓存，公开路由立即失效。
+	m.RefreshPublicPaths()
+
+	slog.Info("js plugin deleted", "entryPath", entryPath, "keepData", keepData)
+	return plugin, nil
+}
+
+// quiesceForDelete 在 m.mu 保护下完成删除的运行态收敛：
+// 冻结入口 → 排空在途消息 → 注销调度器 → 停服 → 移出 services map。
+//
+// 任何步骤失败都返回错误，调用方据此中止破坏性删除；此时插件不会处于
+// 「调度器已摘但 VM 还在跑」的半卸载状态——排空超时会恢复接客，注销/停服
+// 失败则把已停的 service 移出 map，下次请求经懒加载完整重建。
+func (m *Manager) quiesceForDelete(plugin *JSPlugin) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	entryPath := plugin.EntryPath
+
+	value, ok := m.services.Load(entryPath)
+	if !ok {
+		// 插件未加载（空闲驱逐/error/inactive）：回收可能残留的孤儿 JS 环境。
+		// 它们已无调度器入口、不可能执行消息，销毁失败仅告警，不阻断删除。
+		if err := m.jsManager.DestroyPluginEnvs(plugin.ID); err != nil {
+			slog.Warn("cleanup stale plugin envs during delete failed",
+				"entryPath", entryPath, "error", err)
+		}
+		return nil
+	}
+	service := value.(*JSService)
+
+	// 1) 冻结并排空：等待已排队/运行中的调用结束。超时则 unfreeze 回滚，
+	//    注册表与 worker 原封不动，插件继续正常服务。
+	drainTimeout := m.drainTimeout
+	if drainTimeout <= 0 {
+		drainTimeout = pluginDrainTimeout
+	}
+	if err := m.scheduler.DrainService(entryPath, drainTimeout); err != nil {
+		return fmt.Errorf("drain plugin calls before delete: %w", err)
+	}
+
+	// 2) 摘调度器并等待 worker 退出。排空已确认在途归零，这里不应触发超时；
+	//    万一失败（worker 被强制取消），把已停的 service 移出 map，保证不会
+	//    留下「还在跑却删了包」的状态，然后中止本次删除。
+	unregisterTimeout := m.unregisterTimeout
+	if unregisterTimeout <= 0 {
+		unregisterTimeout = pluginUnregisterTimeout
+	}
+	if err := m.scheduler.UnregisterService(entryPath, unregisterTimeout); err != nil {
+		m.services.Delete(entryPath)
+		return fmt.Errorf("unregister plugin scheduler: %w", err)
+	}
+
+	// 3) 停服：定时器处理器、onDeinit、后台进程、UDP/TCP socket、入站
+	//    WebSocket 与全部脚本环境。Stop 内部每一步都会执行，错误向上冒泡。
+	if err := service.Stop(); err != nil {
+		m.services.Delete(entryPath)
+		return fmt.Errorf("stop plugin service: %w", err)
+	}
+
+	m.services.Delete(entryPath)
+	return nil
+}
+
+// markDeleting 仅供包内测试/流程复用；正常入口是 DeletePlugin。
+func (m *Manager) markDeleting(entryPath string) bool {
+	_, exists := m.deleting.LoadOrStore(entryPath, struct{}{})
+	return !exists
+}
+
+// clearDeleting 放开删除阻断（仅供测试/回滚使用）。
+func (m *Manager) clearDeleting(entryPath string) {
+	m.deleting.Delete(entryPath)
+}
+
+// isDeleting 报告插件是否处于删除流程中（阶段 1 与阶段 2 期间均为 true）。
+func (m *Manager) isDeleting(entryPath string) bool {
+	_, ok := m.deleting.Load(entryPath)
+	return ok
+}
+
+// IsPluginDeleting 对外暴露的删除中判定，供 handler 在上传/更新等路径
+// 提前给出 409，避免等包管理器落盘阶段才失败。
+func (m *Manager) IsPluginDeleting(entryPath string) bool {
+	return m.isDeleting(entryPath)
+}
diff --git a/internal/jsplugin/uninstall_state.go b/internal/jsplugin/uninstall_state.go
new file mode 100644
index 0000000..9bfca4f
--- /dev/null
+++ b/internal/jsplugin/uninstall_state.go
@@ -0,0 +1,236 @@
+package jsplugin
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"songloft/internal/database"
+)
+
+// uninstallStateDir 是插件删除墓碑（tombstone）目录，位于 pluginsDir 下。
+// 目录名以点开头，SyncPluginsFromDirectory 只认 .jsplugin.zip 文件，不会误读。
+const uninstallStateDir = ".uninstall"
+
+// ErrPluginUninstalling 插件删除流程尚未收敛（墓碑仍在），任何安装/更新/重载
+// 尝试都必须拒绝，防止残留 ZIP 或新包与删除流程互相覆盖。
+var ErrPluginUninstalling = errors.New("jsplugin: plugin is being uninstalled")
+
+// pluginUninstallState 是删除流程的持久墓碑。
+//
+// 在任何破坏性操作（删 ZIP / 数据目录 / DB 记录）之前原子落盘；只有当三者都
+// 确认不存在后才删除墓碑。进程在任一阶段崩溃，或某一步在 Windows 上因句柄
+// 占用失败，下次启动由 RecoverPendingUninstalls 读到墓碑并继续收敛，保证：
+//   - 不留下「active 记录却没有包」的半卸载状态；
+//   - 残留 ZIP 不会被 SyncPluginsFromDirectory 当新插件重新安装；
+//   - keep_data=true 时数据目录在收敛中始终被保留。
+type pluginUninstallState struct {
+	EntryPath string `json:"entry_path"`
+	// FilePath 是删除开始时 DB 记录中的 ZIP 文件名（通常为 <entryPath>.jsplugin.zip）。
+	FilePath  string `json:"file_path"`
+	KeepData  bool   `json:"keep_data"`
+	CreatedAt string `json:"created_at"`
+	UpdatedAt string `json:"updated_at"`
+}
+
+// uninstallStatePath 返回墓碑文件路径。entryPath 已由 manifest 校验限定为
+// ^[a-z][a-z0-9-]*$，这里再做一层 filepath.Base 防御。
+func (pm *PackageManager) uninstallStatePath(entryPath string) string {
+	return filepath.Join(pm.pluginsDir, uninstallStateDir, filepath.Base(entryPath)+".json")
+}
+
+// saveUninstallState 原子写入墓碑（tmp 文件 + rename），崩溃只会出现
+// 「旧墓碑 / 新墓碑」二者之一，不会留下半截 JSON。
+func (pm *PackageManager) saveUninstallState(state *pluginUninstallState) error {
+	dir := filepath.Join(pm.pluginsDir, uninstallStateDir)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("create uninstall state dir: %w", err)
+	}
+
+	data, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshal uninstall state: %w", err)
+	}
+
+	final := pm.uninstallStatePath(state.EntryPath)
+	tmp := final + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return fmt.Errorf("write uninstall state temp file: %w", err)
+	}
+	if err := os.Rename(tmp, final); err != nil {
+		_ = os.Remove(tmp)
+		return fmt.Errorf("rename uninstall state file: %w", err)
+	}
+	return nil
+}
+
+// removeUninstallState 删除墓碑。文件不存在视为成功（幂等收敛）。
+func (pm *PackageManager) removeUninstallState(entryPath string) error {
+	err := os.Remove(pm.uninstallStatePath(entryPath))
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
+}
+
+// hasUninstallState 报告指定插件是否有未收敛的删除墓碑。
+func (pm *PackageManager) hasUninstallState(entryPath string) bool {
+	_, err := os.Stat(pm.uninstallStatePath(entryPath))
+	return err == nil
+}
+
+// uninstallStateEntries 返回所有待收敛墓碑的 entryPath 集合。
+func (pm *PackageManager) uninstallStateEntries() map[string]bool {
+	entries := make(map[string]bool)
+	dir := filepath.Join(pm.pluginsDir, uninstallStateDir)
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return entries
+		}
+		slog.Warn("read uninstall state dir failed", "dir", dir, "error", err)
+		return entries
+	}
+	for _, f := range files {
+		if f.IsDir() || !strings.HasSuffix(f.Name(), ".json") {
+			continue
+		}
+		entries[strings.TrimSuffix(f.Name(), ".json")] = true
+	}
+	return entries
+}
+
+// loadUninstallState 读取并校验单个墓碑；损坏的墓碑返回错误，由调用方记录并
+// 保留现场（不静默删除，避免丢删除意图）。
+func (pm *PackageManager) loadUninstallState(entryPath string) (*pluginUninstallState, error) {
+	data, err := os.ReadFile(pm.uninstallStatePath(entryPath))
+	if err != nil {
+		return nil, err
+	}
+	var state pluginUninstallState
+	if err := json.Unmarshal(data, &state); err != nil {
+		return nil, fmt.Errorf("parse uninstall state for %q: %w", entryPath, err)
+	}
+	if state.EntryPath == "" {
+		state.EntryPath = entryPath
+	}
+	if state.EntryPath != entryPath {
+		return nil, fmt.Errorf("uninstall state entry_path mismatch: file=%q content=%q", entryPath, state.EntryPath)
+	}
+	return &state, nil
+}
+
+// beginUninstall 在破坏性删除前落盘墓碑。墓碑已存在时视为幂等成功（重复删除
+// 或崩溃后的同进程重试），刷新 UpdatedAt。
+func (pm *PackageManager) beginUninstall(entryPath, filePath string, keepData bool) (*pluginUninstallState, error) {
+	now := time.Now().UTC().Format(time.RFC3339)
+	state := &pluginUninstallState{
+		EntryPath: entryPath,
+		FilePath:  filePath,
+		KeepData:  keepData,
+		CreatedAt: now,
+		UpdatedAt: now,
+	}
+	if existing, err := pm.loadUninstallState(entryPath); err == nil {
+		// 已存在墓碑：沿用原 CreatedAt 与 keep_data 语义（首次删除的意图优先），
+		// 只刷新目标 ZIP 文件名与更新时间。
+		state.CreatedAt = existing.CreatedAt
+		state.KeepData = existing.KeepData
+	}
+	if err := pm.saveUninstallState(state); err != nil {
+		return nil, err
+	}
+	return state, nil
+}
+
+// finishUninstall 按墓碑收敛删除，全程幂等，可在崩溃/失败后反复调用：
+//  1. 删除 ZIP（不存在视为成功）；
+//  2. keep_data=false 时删除插件数据目录（static/bin/cache 等，不存在视为成功）；
+//  3. 删除 js_plugins DB 记录（已不存在视为成功）；
+//  4. 全部确认后删除墓碑。
+//
+// 任一步失败立即返回错误并保留墓碑，等待下次调用（同进程重试或下次启动）。
+func (pm *PackageManager) finishUninstall(ctx context.Context, state *pluginUninstallState) error {
+	// [1] 删除 ZIP。墓碑记录的 FilePath 与约定文件名都尝试一遍，兼容历史数据。
+	zipNames := []string{filepath.Base(state.FilePath), state.EntryPath + ".jsplugin.zip"}
+	zipNames = slices.Compact(zipNames)
+	for _, name := range zipNames {
+		if name == "" || name == "." || filepath.IsAbs(name) {
+			continue
+		}
+		zipPath := filepath.Join(pm.pluginsDir, name)
+		if err := os.Remove(zipPath); err != nil && !os.IsNotExist(err) {
+			return fmt.Errorf("remove plugin zip %q: %w", zipPath, err)
+		}
+	}
+
+	// [2] 删除数据目录（keep_data=true 时保留；宿主 DB 中的 plugin_storage
+	// 沿用既有卸载保留语义，从来不在此处理）。
+	if !state.KeepData {
+		dataPath := filepath.Join(pm.dataDir, state.EntryPath)
+		if err := os.RemoveAll(dataPath); err != nil {
+			return fmt.Errorf("remove plugin data dir %q: %w", dataPath, err)
+		}
+	}
+
+	// [3] 删除 DB 记录（若仍存在）。
+	plugin, err := pm.repo.GetByEntryPath(ctx, state.EntryPath)
+	switch {
+	case err == nil && plugin != nil:
+		if err := pm.repo.Delete(ctx, plugin.ID); err != nil {
+			return fmt.Errorf("delete plugin record %q: %w", state.EntryPath, err)
+		}
+	case errors.Is(err, database.ErrNotFound):
+		// 记录已删，继续清理墓碑。
+	default:
+		return fmt.Errorf("lookup plugin record %q: %w", state.EntryPath, err)
+	}
+
+	// [4] 全部目标已不存在，最后删墓碑。删墓碑失败仅告警：所有删除目标已确认
+	// 消失，下次启动的收敛流程会再次走到这里并成功。
+	if err := pm.removeUninstallState(state.EntryPath); err != nil {
+		slog.Warn("remove uninstall state failed, will retry on next startup",
+			"entryPath", state.EntryPath, "error", err)
+	}
+	return nil
+}
+
+// RecoverPendingUninstalls 在启动扫描前收敛所有未完成的删除。
+// 返回成功收敛的插件 entryPath 列表；单个墓碑失败不阻断其他墓碑的收敛。
+func (pm *PackageManager) RecoverPendingUninstalls() ([]string, error) {
+	pending := pm.uninstallStateEntries()
+	if len(pending) == 0 {
+		return nil, nil
+	}
+
+	ctx := context.Background()
+	recovered := make([]string, 0, len(pending))
+	var errs []error
+	for entryPath := range pending {
+		state, err := pm.loadUninstallState(entryPath)
+		if err != nil {
+			// 损坏墓碑：保留现场并报错，不能一删了之（删除意图可能仍需收敛）。
+			errs = append(errs, err)
+			slog.Error("uninstall state unreadable, skipping recovery",
+				"entryPath", entryPath, "error", err)
+			continue
+		}
+		if err := pm.finishUninstall(ctx, state); err != nil {
+			errs = append(errs, err)
+			slog.Error("resume plugin uninstall failed",
+				"entryPath", entryPath, "keepData", state.KeepData, "error", err)
+			continue
+		}
+		slog.Info("resumed and completed plugin uninstall",
+			"entryPath", entryPath, "keepData", state.KeepData)
+		recovered = append(recovered, entryPath)
+	}
+	return recovered, errors.Join(errs...)
+}
diff --git a/internal/jsplugin/uninstall_test.go b/internal/jsplugin/uninstall_test.go
new file mode 100644
index 0000000..e88387c
--- /dev/null
+++ b/internal/jsplugin/uninstall_test.go
@@ -0,0 +1,707 @@
+package jsplugin
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"songloft/internal/database"
+)
+
+// blockingHandler 用 gate 精确控制消息处理时机，用于调度器排空测试。
+type blockingHandler struct {
+	gate    chan struct{} // 关闭后 HandleMessage 才放行
+	mu      sync.Mutex
+	count   int
+	hasGate chan struct{} // 每次开始处理时发送一个信号（缓冲 1）
+}
+
+func newBlockingHandler() *blockingHandler {
+	return &blockingHandler{gate: make(chan struct{}), hasGate: make(chan struct{}, 64)}
+}
+
+func (h *blockingHandler) HandleMessage(msg *Message) *Message {
+	h.hasGate <- struct{}{}
+	<-h.gate
+	h.mu.Lock()
+	h.count++
+	h.mu.Unlock()
+	return &Message{ID: msg.ID, Session: msg.Session, Data: "ok"}
+}
+
+func (h *blockingHandler) calls() int {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.count
+}
+
+// TestScheduler_DrainService_WaitsInflight 验证排空等待在途消息全部处理完才返回，
+// 排空后新消息被拒绝。
+func TestScheduler_DrainService_WaitsInflight(t *testing.T) {
+	sched := NewServiceScheduler(1)
+	defer sched.Close()
+
+	h := newBlockingHandler()
+	if err := sched.RegisterService("svc", h, 16); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+
+	// 1 个在途同步调用 + 3 个排队消息，全部被 gate 挡住。
+	callDone := make(chan error, 1)
+	go func() {
+		_, err := sched.Call(context.Background(), "svc", "", MsgHTTPRequest, "x", 5*time.Second)
+		callDone <- err
+	}()
+	<-h.hasGate // 等第一条真正开始处理，确保它在排空开始前已在途
+
+	for range 3 {
+		if err := sched.Send(&Message{Type: MsgLifecycle, Target: "svc"}); err != nil {
+			t.Fatalf("send queued: %v", err)
+		}
+	}
+
+	drainDone := make(chan error, 1)
+	go func() { drainDone <- sched.DrainService("svc", 3*time.Second) }()
+
+	// 排空开始与本 goroutine 无同步：freeze 之前探测消息可能被正常接收（计数），
+	// freeze 之后必须收到 ErrServiceUnregistered。
+	probeAccepted := 0
+	deadline := time.After(1 * time.Second)
+	rejected := false
+	for !rejected {
+		select {
+		case <-deadline:
+			t.Fatal("drain 期间新消息仍可入队，入口未冻结")
+		default:
+		}
+		if err := sched.Send(&Message{Type: MsgLifecycle, Target: "svc"}); err != nil {
+			if errors.Is(err, ErrServiceUnregistered) {
+				rejected = true
+				break
+			}
+			t.Fatalf("drain 期间意外错误: %v", err)
+		}
+		probeAccepted++
+		time.Sleep(2 * time.Millisecond)
+	}
+
+	// gate 未放行前排空不能成功。
+	select {
+	case err := <-drainDone:
+		t.Fatalf("仍有在途消息时 DrainService 却返回了: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	close(h.gate)
+
+	select {
+	case err := <-drainDone:
+		if err != nil {
+			t.Fatalf("DrainService 应在全部消息处理完后成功: %v", err)
+		}
+	case <-time.After(3*time.Second + 100*time.Millisecond):
+		t.Fatal("DrainService 超时")
+	}
+
+	select {
+	case err := <-callDone:
+		if err != nil {
+			t.Fatalf("在途调用应正常拿到响应: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("在途调用未返回")
+	}
+
+	if got, want := h.calls(), 4+probeAccepted; got != want {
+		t.Errorf("排空应处理完 1 调用+3 排队+%d 探测 = %d 条消息，实际 %d",
+			probeAccepted, want, got)
+	}
+
+	// 排空成功后摘注册（关闭队列，worker 应立刻退出）。
+	if err := sched.UnregisterService("svc", time.Second); err != nil {
+		t.Fatalf("unregister after drain: %v", err)
+	}
+}
+
+// TestScheduler_DrainService_TimeoutRollback 验证排空超时后服务恢复接客，
+// 调用方可以据此中止卸载。
+func TestScheduler_DrainService_TimeoutRollback(t *testing.T) {
+	sched := NewServiceScheduler(1)
+	defer sched.Close()
+
+	h := newBlockingHandler()
+	if err := sched.RegisterService("svc", h, 16); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+
+	go func() {
+		_, _ = sched.Call(context.Background(), "svc", "", MsgHTTPRequest, "x", 5*time.Second)
+	}()
+	<-h.hasGate
+
+	start := time.Now()
+	err := sched.DrainService("svc", 80*time.Millisecond)
+	if !errors.Is(err, ErrDrainTimeout) {
+		t.Fatalf("期望 ErrDrainTimeout，got %v", err)
+	}
+	if d := time.Since(start); d > 800*time.Millisecond {
+		t.Errorf("排空超时应在 ~80ms 返回，实际 %v", d)
+	}
+
+	// 回滚后放行长任务，服务应能继续处理新消息。
+	close(h.gate)
+	deadline := time.After(3 * time.Second)
+	for h.calls() < 1 {
+		select {
+		case <-deadline:
+			t.Fatal("在途消息未处理完")
+		default:
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+
+	if err := sched.Send(&Message{Type: MsgLifecycle, Target: "svc"}); err != nil {
+		t.Fatalf("排空超时回滚后服务应恢复接客，Send 失败: %v", err)
+	}
+	deadline = time.After(3 * time.Second)
+	for h.calls() < 2 {
+		select {
+		case <-deadline:
+			t.Fatal("回滚后新消息未被处理")
+		default:
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+}
+
+// slowPluginJS 提供一个 ~1.2s 的慢端点与即时端点。
+const slowPluginJS = `
+function onInit() {}
+function onDeinit() {}
+async function onHTTPRequest(req) {
+    if (req.path === "/slow") {
+        await new Promise(function(r) { setTimeout(r, 1200); });
+        return {statusCode: 200, headers: {"Content-Type": "application/json"}, body: '{"ok":"slow"}'};
+    }
+    return {statusCode: 200, headers: {"Content-Type": "application/json"}, body: '{"hello":"world"}'};
+}
+`
+
+// setupLoadedPlugin 安装并加载一个可用的测试插件，返回 manager 与记录。
+func setupLoadedPlugin(t *testing.T, entryPath, jsCode string, publicPaths []string) (*Manager, *JSPlugin, string, string) {
+	t.Helper()
+
+	pluginsDir, dataDir, repo, _ := setupTestEnv(t)
+	manifest := testManifest(entryPath)
+	manifest.PublicPaths = publicPaths
+	zipData := createTestPluginZipWithStatic(t, manifest, jsCode, map[string]string{
+		"index.html": "<head></head><body>plugin page</body>",
+	})
+	plugin, _, err := NewPackageManager(pluginsDir, dataDir, repo).InstallFromUpload(zipData)
+	if err != nil {
+		t.Skipf("InstallFromUpload failed (may need QuickJS toolchain): %v", err)
+	}
+
+	manager := NewManager(repo, pluginsDir, dataDir, "", nil, nil)
+	t.Cleanup(func() { manager.Close() })
+
+	if err := manager.EnablePlugin(context.Background(), plugin.ID); err != nil {
+		t.Skipf("EnablePlugin failed (may need QuickJS runtime): %v", err)
+	}
+	if _, ok := manager.GetService(entryPath); !ok {
+		t.Skip("plugin service not loaded, skip QuickJS-dependent test")
+	}
+	return manager, plugin, pluginsDir, dataDir
+}
+
+func pluginPing(t *testing.T, m *Manager, entryPath string) {
+	t.Helper()
+	status, _, body, err := m.InvokeHTTP(context.Background(), entryPath, "GET", "/ping", nil, nil)
+	if err != nil {
+		t.Fatalf("InvokeHTTP /ping: %v", err)
+	}
+	if status != 200 {
+		t.Fatalf("期望 200，got %d body=%s", status, string(body))
+	}
+}
+
+func assertPluginGone(t *testing.T, m *Manager, pm *PackageManager, plugin *JSPlugin, pluginsDir, dataDir string, keepData bool) {
+	t.Helper()
+	entryPath := plugin.EntryPath
+
+	if _, err := os.Stat(filepath.Join(pluginsDir, plugin.FilePath)); !os.IsNotExist(err) {
+		t.Errorf("ZIP 应已删除: %v", err)
+	}
+	if _, err := m.repo.GetByEntryPath(context.Background(), entryPath); !errors.Is(err, database.ErrNotFound) {
+		t.Errorf("DB 记录应已删除，got err=%v", err)
+	}
+	if _, ok := m.GetService(entryPath); ok {
+		t.Error("services map 不应再有该插件")
+	}
+	if m.scheduler.HasService(entryPath) {
+		t.Error("scheduler 不应再有该插件")
+	}
+	_, lyricOK := m.lyricProviders.Load(entryPath)
+	_, coverOK := m.coverProviders.Load(entryPath)
+	_, subOK := m.playEventSubscribers.Load(entryPath)
+	if lyricOK || coverOK || subOK {
+		t.Errorf("提供者/订阅注册应已清除: lyric=%v cover=%v sub=%v", lyricOK, coverOK, subOK)
+	}
+	if m.IsPublicPath("/api/v1/jsplugin/" + entryPath + "/api/callback") {
+		t.Error("publicPaths 应已移除")
+	}
+	if m.IsPluginDeleting(entryPath) {
+		t.Error("删除成功后 deleting 标记应清除")
+	}
+	if pm.hasUninstallState(entryPath) {
+		t.Error("删除成功后墓碑应已清除")
+	}
+	pluginDataDir := filepath.Join(dataDir, entryPath)
+	if _, err := os.Stat(pluginDataDir); keepData && os.IsNotExist(err) {
+		t.Error("keep_data=true 时插件数据目录应保留")
+	} else if !keepData && err == nil {
+		t.Error("默认删除时插件数据目录应已删除")
+	}
+}
+
+// TestDeletePlugin_FullLifecycle 端到端：运行中插件删除后，运行态注册、
+// 文件、DB、墓碑、publicPaths 全部清空，且同 entryPath 可立即重装。
+func TestDeletePlugin_FullLifecycle(t *testing.T) {
+	entryPath := "test-del-full"
+	m, plugin, pluginsDir, dataDir := setupLoadedPlugin(t, entryPath, simpleJSCode, []string{"/api/callback"})
+	pm := m.packager
+
+	pluginPing(t, m, entryPath)
+
+	// 挂上三类运行态注册。
+	m.RegisterLyricProvider(entryPath)
+	m.RegisterCoverProvider(entryPath)
+	m.RegisterPlayEvent(entryPath)
+	m.RefreshPublicPaths()
+	if !m.IsPublicPath("/api/v1/jsplugin/" + entryPath + "/api/callback") {
+		t.Fatal("删除前 publicPath 应命中")
+	}
+
+	if _, err := m.DeletePlugin(context.Background(), plugin.ID, false); err != nil {
+		t.Fatalf("DeletePlugin: %v", err)
+	}
+
+	assertPluginGone(t, m, pm, plugin, pluginsDir, dataDir, false)
+
+	// 删除后公开路由立即 404（EnsureLoaded 拒绝）。
+	if _, err := m.EnsureLoaded(context.Background(), entryPath); !errors.Is(err, ErrPluginNotFound) {
+		t.Errorf("删除后 EnsureLoaded 应 ErrPluginNotFound，got %v", err)
+	}
+
+	// 同一 entryPath 重新安装并正常工作。
+	manifest := testManifest(entryPath)
+	manifest.PublicPaths = []string{"/api/callback"}
+	zipData := createTestPluginZipWithStatic(t, manifest, simpleJSCode, map[string]string{
+		"index.html": "<head></head><body>reinstalled</body>",
+	})
+	newPlugin, _, err := pm.InstallFromUpload(zipData)
+	if err != nil {
+		t.Fatalf("同 entryPath 重装被拒: %v", err)
+	}
+	if err := m.EnablePlugin(context.Background(), newPlugin.ID); err != nil {
+		t.Fatalf("重装后 EnablePlugin: %v", err)
+	}
+	pluginPing(t, m, entryPath)
+}
