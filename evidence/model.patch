+func (h *JSPluginHandler) rejectIfDeleting(w http.ResponseWriter, r *http.Request, pluginID int64) bool {
+	if h.manager == nil {
+		return false
+	}
+	existing, err := h.repo.GetByID(r.Context(), pluginID)
+	if err != nil || existing == nil {
+		// 不存在的情况交给后续操作按既有 404 语义处理。
+		return false
+	}
